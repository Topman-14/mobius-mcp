{
  "name": "mobius-mcp",
  "version": "1.1.0",
  "description": "MCP server exposing live browser runtime events to AI coding agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mobius-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mobius-mcp/capture-core": "0.0.1",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "prebuild": "node scripts/build-skill-prompts.mjs",
    "build": "tsup src/index.ts --format esm --target node18 --clean",
    "prewatch": "node scripts/build-skill-prompts.mjs",
    "watch": "tsup src/index.ts --format esm --target node18 --watch",
    "start": "node dist/index.js",
    "test": "vitest run"
  }
}
